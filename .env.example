# ── LLM API Keys ──
OPENAI_API_KEY=your_openai_api_key_here
# GOOGLE_API_KEY=your_gemini_api_key_here  # optional alternative

# ── App Settings ──
APP_NAME=MAPIS
APP_ENV=development
APP_PORT=8000
SECRET_KEY=your_secret_key_change_this_in_production

# ── Redis (session state) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Database ──
DATABASE_URL=sqlite+aiosqlite:///./mapis.db

# ── Trust Scoring Thresholds ──
TRUST_BLOCK_THRESHOLD=0.3
TRUST_WARN_THRESHOLD=0.6
SESSION_HISTORY_LIMIT=50

# ── CORS ──
FRONTEND_URL=http://localhost:3000

# ── Logging ──
LOG_LEVEL=INFO
