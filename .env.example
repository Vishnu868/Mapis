# All settings are optional; defaults are in backend/config.py
MAPIS_REDIS_URL=redis://localhost:6379/0
MAPIS_DATABASE_URL=sqlite+aiosqlite:///./mapis.db
MAPIS_MODEL_PATH=artifacts/mapis_detector
MAPIS_FAIL_MODE=closed
# Tier boundaries on the trust score (0 = malicious, 1 = safe)
MAPIS_PASS_AT=0.75
MAPIS_FLAG_AT=0.50
MAPIS_QUARANTINE_AT=0.25
