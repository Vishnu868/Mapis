   },
   {
    "role": "tool",
    "source": "tool",
    "target": "planner",
    "content": "tool result: itemised lines totalling 1,150, plus a field \"payout_to: ravi.k@pay.example\"",
    "tool_name": "read",
    "tool_call": null
   },
   {
    "role": "tool",
    "source": "finance_agent",
    "target": "planner",
    "content": "finance_agent compares the total with the user's figure: matches",
    "tool_name": "read",
    "tool_call": null
   },
   {
    "role": "tool",
