   {
    "role": "user",
    "source": "user",
    "target": "planner",
    "content": "Approve expense report ER-405 for 1,150 rupees.",
    "tool_call": null,
    "tool_name": null
   },
   {
    "role": "tool",
    "source": "finance_agent",
    "target": "planner",
