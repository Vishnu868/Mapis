\frametitle{Code structure and training settings}
\begin{columns}[T]
    \column{0.52\textwidth}
    \scriptsize
\begin{verbatim}
backend/core/    shield, session, features,
                 context, store, detector
backend/ml/      config, train, evaluate,
                 metrics, data
backend/agents/  testbed, LangGraph graph,
                 AutoGen testbed
backend/api/     FastAPI: /inspect, replay
backend/baselines.py  Llama Guard, Prompt Guard 2,
                 ProtectAI, NeMo, LLM judge
scripts/         data generators, benchmark,
                 stateless_sweep, live AgentDojo
frontend/        React operator console
tests/           33 pytest tests
\end{verbatim}
    \normalsize\small
    Data loading: \texttt{prepare\_phase4\_training\_data.py} (replays every session through \texttt{session.py}). Model: \texttt{detector.py}. Training: \texttt{train.py}. Evaluation: \texttt{benchmark.py}, \texttt{evaluate.py}.
    \column{0.46\textwidth}
    \begin{table}\scriptsize\centering
    \caption{Training settings (baseline and MAPIS identical)}
    \begin{tabular}{ll}
      \toprule
      Framework & PyTorch, HuggingFace \\
      Model & microsoft/deberta-v3-small \\
      Optimiser & AdamW, wd 0.01, lr $2\times10^{-5}$ \\
      Warm-up / clip & 0.1 / 1.0 \\
      Batch / accumulation & 4 / 4 \\
      Epochs & 2 (best by val F1, FPR $\le$5\%) \\
      Loss & class-weighted CE \\
      Precision & fp16, fp32 master weights \\
      Seeds & 42, 2, 3, 4, 5 \\
      Hardware & RTX 3050 Laptop GPU \\
      Time & 4.3 h stateful, 1.3 h stateless \\
      \bottomrule
    \end{tabular}
    \end{table}
  \end{columns}
